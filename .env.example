# Environment Configuration Example
# Copy this file to .env.local and update values as needed

# Web3Forms Contact Form
# Get your access key from https://web3forms.com
# Note: Must use NEXT_PUBLIC_ prefix because Web3Forms requires client-side calls
# The key is public but Cloudflare protected (safe from abuse)
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Analytics (if added in future)
# NEXT_PUBLIC_GA_ID=

# API Keys (if backend added)
# NEXT_PUBLIC_API_URL=

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Security
# NEXT_PUBLIC_CSP_REPORT_URI=

# Note: NEXT_PUBLIC_* variables are exposed to browser
# Use other variables only for server-side code
